DATABASE_URL=postgres://tranche:tranche@localhost:5433/tranche
# Disposable integration tests only; never set this to the application database.
TEST_DATABASE_URL=

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Explicit workspace-to-repository bindings, e.g. {"workspace-uuid":["owner/repo"]}.
GITHUB_WORKSPACE_REPOSITORIES={}
PAGESPEED_API_KEY=
# Defaults to Google; local fixtures must use localhost:4020 with both test guards below.
PAGESPEED_API_BASE=
# Effective only with NODE_ENV=test, and only for http://localhost:4020.
VERIFIER_ALLOW_TEST_LOCALHOST=

RENDER_API_KEY=
# Workflows service slug; set it so a received webhook starts the money tick right away.
RENDER_WORKFLOW_SLUG=
RESEND_API_KEY=
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# End-to-end runs against the fake PayPal only: renders the fake-paypal-approve button.
NEXT_PUBLIC_E2E_FAKE_PAYPAL=
# Optional legacy external screenshot origin. New screenshots use authenticated DB-backed routes.
EVIDENCE_IMAGE_ORIGIN=
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=

# PayPal money layer (sandbox only). PAYPAL_API_BASE defaults to the sandbox; e2e points it at the fake server.
PAYPAL_API_BASE=
HOLD_MECHANISM=authorization
# Only agency_pays is supported; anything else stops the agents service (docs/paypal/subcontractor-split.md).
SUBCONTRACTOR_SPLIT=agency_pays
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
SANDBOX_SELLER_MERCHANT_ID=

# Agent generation. off pauses model-dependent consumers without stopping money tasks.
TRANCHE_LLM=off
AI_FALLBACK=
GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.8-flash
OPENAI_JUDGE_MODEL=gpt-5.4-mini
OPENAI_FAST_MODEL=gpt-5.4-nano
