{
  "name": "@tranche/agents-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./deployment": "./src/deployment/config.ts",
    "./launch": "./src/agents/launch.ts",
    "./money": "./src/money/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "typecheck": "tsc",
    "money:recover": "node --env-file-if-exists=../../.env --import=tsx scripts/recover-creation.ts",
    "f0:preflight": "node --env-file-if-exists=../../.env --import=tsx scripts/f0/preflight.ts",
    "f0:runner": "node --env-file-if-exists=../../.env --import=tsx scripts/f0/index.ts",
    "test": "vitest run --passWithNoTests",
    "consume:local": "node --env-file-if-exists=../../.env --import=tsx src/agents/local-loop.ts"
  },
  "dependencies": {
    "@tranche/agents": "workspace:*",
    "@tranche/contracts": "workspace:*",
    "@tranche/core": "workspace:*",
    "@tranche/db": "workspace:*",
    "@tranche/paypal": "workspace:*",
    "@tranche/verifiers": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg-boss": "12.38.0",
    "playwright": "1.64.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsdown": "0.23.0",
    "tsx": "4.23.15"
  }
}
